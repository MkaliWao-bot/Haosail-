rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Core identity and validation primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOrderId(id) {
      return id is string && id.size() >= 4 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && request.auth.token.email == 'felitexcyber001@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation Blueprint: AdminAccount (/admins/{adminId})
    function isValidAdminAccount(data, adminId) {
      return data.keys().hasAll(['uid', 'email', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'staffName', 'roleLabel', 'inviteId', 'grantedBy', 'createdAt'])
        && data.uid is string
        && data.uid == adminId
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && (!('staffName' in data) || (data.staffName is string && data.staffName.size() <= 100))
        && (!('roleLabel' in data) || (data.roleLabel is string && data.roleLabel.size() <= 80))
        && (!('inviteId' in data) || isOrderId(data.inviteId))
        && data.grantedBy is string
        && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    // Validation Blueprint: AdminInvite (/adminInvites/{inviteId})
    function isValidAdminInvite(data, inviteId) {
      return data.keys().hasAll(['inviteId', 'email', 'status', 'invitedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['inviteId', 'email', 'staffName', 'roleLabel', 'status', 'invitedBy', 'claimedUid', 'createdAt', 'updatedAt'])
        && data.inviteId is string
        && data.inviteId == inviteId
        && isOrderId(data.inviteId)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && (!('staffName' in data) || (data.staffName is string && data.staffName.size() <= 100))
        && (!('roleLabel' in data) || (data.roleLabel is string && data.roleLabel.size() <= 80))
        && data.status in ['pending', 'claimed', 'revoked']
        && data.invitedBy is string
        && isValidId(data.invitedBy)
        && (!('claimedUid' in data) || isValidId(data.claimedUid))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: CatalogOverride (/catalogOverrides/{productId})
    function isValidCatalogOverride(data, productId) {
      return data.keys().hasAll(['productId', 'priceKes', 'inStock', 'stockCount', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['productId', 'priceKes', 'inStock', 'stockCount', 'archived', 'updatedBy', 'updatedAt'])
        && data.productId is string
        && data.productId == productId
        && isOrderId(data.productId)
        && (data.priceKes is int || data.priceKes is float)
        && data.priceKes >= 100
        && data.priceKes <= 50000000
        && data.inStock is bool
        && data.stockCount is int
        && data.stockCount >= 0
        && data.stockCount <= 10000
        && (!('archived' in data) || data.archived is bool)
        && data.updatedBy is string
        && data.updatedBy == request.auth.uid
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: CatalogProduct (/catalogProducts/{productId})
    function isValidCatalogProduct(data, productId) {
      return data.keys().hasAll([
          'productId', 'sku', 'name', 'subtitle', 'category', 'categoryLabel',
          'priceKes', 'stockCount', 'inStock', 'freightTier', 'isFreeFreight',
          'image', 'powerSource', 'motor', 'voltage', 'amperage', 'capacity',
          'footprint', 'weightLbs', 'warrantyYears', 'description',
          'features', 'includedItems', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'productId', 'sku', 'name', 'subtitle', 'category', 'categoryLabel',
          'subCategory', 'subCategoryLabel', 'priceKes', 'originalPriceKes',
          'stockCount', 'inStock', 'freightTier', 'isFreeFreight', 'isPopular',
          'isNewArrival', 'image', 'powerSource', 'motor', 'voltage', 'amperage',
          'capacity', 'footprint', 'weightLbs', 'warrantyYears', 'description',
          'features', 'includedItems', 'createdBy', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.productId is string
        && data.productId == productId
        && isOrderId(data.productId)
        && data.sku is string && data.sku.size() >= 2 && data.sku.size() <= 40
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 140
        && data.subtitle is string && data.subtitle.size() >= 1 && data.subtitle.size() <= 200
        && data.category in ['woodworking', 'auto-maintenance', 'welding-metalworking', 'construction-concrete', 'workshop-tools']
        && data.categoryLabel is string && data.categoryLabel.size() >= 2 && data.categoryLabel.size() <= 80
        && (!('subCategory' in data) || (data.subCategory is string && data.subCategory.size() <= 60))
        && (!('subCategoryLabel' in data) || (data.subCategoryLabel is string && data.subCategoryLabel.size() <= 80))
        && (data.priceKes is int || data.priceKes is float) && data.priceKes >= 100 && data.priceKes <= 50000000
        && (!('originalPriceKes' in data) || ((data.originalPriceKes is int || data.originalPriceKes is float) && data.originalPriceKes >= 0 && data.originalPriceKes <= 50000000))
        && data.stockCount is int && data.stockCount >= 0 && data.stockCount <= 10000
        && data.inStock is bool
        && data.freightTier in ['standard-ground', 'freight-ltl', 'heavy-freight']
        && data.isFreeFreight is bool
        && (!('isPopular' in data) || data.isPopular is bool)
        && (!('isNewArrival' in data) || data.isNewArrival is bool)
        && data.image is string && data.image.size() >= 1 && data.image.size() <= 1000
        && data.powerSource in ['all', 'corded-230v', 'corded-115v', 'cordless-18v', '3-phase-400v', 'engine-manual']
        && data.motor is string && data.motor.size() >= 1 && data.motor.size() <= 100
        && data.voltage is string && data.voltage.size() >= 1 && data.voltage.size() <= 80
        && data.amperage is string && data.amperage.size() >= 1 && data.amperage.size() <= 60
        && data.capacity is string && data.capacity.size() >= 1 && data.capacity.size() <= 120
        && data.footprint is string && data.footprint.size() >= 1 && data.footprint.size() <= 100
        && (data.weightLbs is int || data.weightLbs is float) && data.weightLbs >= 1 && data.weightLbs <= 100000
        && data.warrantyYears is int && data.warrantyYears >= 1 && data.warrantyYears <= 10
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 1500
        && data.features is list && data.features.size() <= 12 && (data.features.size() == 0 || data.features[0] is string)
        && data.includedItems is list && data.includedItems.size() <= 12 && (data.includedItems.size() == 0 || data.includedItems[0] is string)
        && data.createdBy is string && isValidId(data.createdBy)
        && data.updatedBy is string && data.updatedBy == request.auth.uid && isValidId(data.updatedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserAccount (/users/{userId})
    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'workshopName', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && (!('workshopName' in data) || (data.workshopName is string && data.workshopName.size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserPrivateInfo (/users/{userId}/private/{docId})
    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'kraPin', 'address', 'preferredCountyId', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 120
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 30))
        && (!('kraPin' in data) || (data.kraPin is string && data.kraPin.size() <= 20))
        && (!('address' in data) || (data.address is string && data.address.size() <= 200))
        && (!('preferredCountyId' in data) || (data.preferredCountyId is string && data.preferredCountyId.size() <= 40 && data.preferredCountyId.matches('^[a-z0-9\\-]+$')))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserOrder (/users/{userId}/orders/{orderId})
    function isValidUserOrder(data, userId, orderId) {
      return data.keys().hasAll([
          'orderId', 'userId', 'countyId', 'deliveryMode',
          'settlementMode', 'status', 'totalAmountKes', 'itemCount',
          'itemsSummary', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderId', 'userId', 'companyName', 'countyId', 'deliveryMode',
          'settlementMode', 'paymentMethod', 'status', 'totalAmountKes', 'itemCount',
          'itemsSummary', 'voucherCode', 'etimsControlNumber', 'createdAt', 'updatedAt'
        ])
        && data.orderId is string
        && data.orderId == orderId
        && isOrderId(data.orderId)
        && data.userId is string
        && data.userId == userId
        && (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 120))
        && data.countyId is string
        && data.countyId.size() >= 1
        && data.countyId.size() <= 40
        && data.countyId.matches('^[a-z0-9\\-]+$')
        && data.deliveryMode in ['direct-site', 'depot-pickup']
        && data.settlementMode in ['full', 'lipa-pole-pole']
        && (!('paymentMethod' in data) || data.paymentMethod in ['mpesa', 'bank-wire', 'lpo-credit', 'depot-pay'])
        && data.status in ['confirmed', 'dispatched', 'completed']
        && (data.totalAmountKes is int || data.totalAmountKes is float)
        && data.totalAmountKes >= 0
        && data.itemCount is int
        && data.itemCount >= 1
        && data.itemCount <= 500
        && data.itemsSummary is string
        && data.itemsSummary.size() >= 1
        && data.itemsSummary.size() <= 500
        && (!('voucherCode' in data) || (data.voucherCode is string && data.voucherCode.size() <= 30))
        && (!('etimsControlNumber' in data) || (data.etimsControlNumber is string && data.etimsControlNumber.size() <= 64))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrderTransition(prevStatus, nextStatus) {
      return (prevStatus == 'confirmed' && nextStatus in ['confirmed', 'dispatched', 'completed'])
        || (prevStatus == 'dispatched' && nextStatus in ['dispatched', 'completed']);
    }

    // Live Catalog Overrides (publicly readable non-PII pricing/stock/archive; Admin-only writes)
    match /catalogOverrides/{productId} {
      allow get: if isOrderId(productId);
      allow list: if request.query.limit <= 200;

      allow create: if isOrderId(productId)
        && isAdmin()
        && isValidCatalogOverride(incoming(), productId)
        && incoming().updatedAt == request.time;

      allow update: if isOrderId(productId)
        && isAdmin()
        && isValidCatalogOverride(incoming(), productId)
        && incoming().productId == existing().productId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['priceKes', 'inStock', 'stockCount', 'archived', 'updatedBy', 'updatedAt']);

      allow delete: if isOrderId(productId) && isAdmin();
    }

    // Admin-Created Dynamic Catalog Products (publicly readable non-PII catalog; Admin-only CRUD)
    match /catalogProducts/{productId} {
      allow get: if isOrderId(productId);
      allow list: if request.query.limit <= 200;

      allow create: if isOrderId(productId)
        && isAdmin()
        && isValidCatalogProduct(incoming(), productId)
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOrderId(productId)
        && isAdmin()
        && isValidCatalogProduct(incoming(), productId)
        && incoming().productId == existing().productId
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'sku', 'name', 'subtitle', 'category', 'categoryLabel',
          'subCategory', 'subCategoryLabel', 'priceKes', 'originalPriceKes',
          'stockCount', 'inStock', 'freightTier', 'isFreeFreight', 'isPopular',
          'isNewArrival', 'image', 'powerSource', 'motor', 'voltage', 'amperage',
          'capacity', 'footprint', 'weightLbs', 'warrantyYears', 'description',
          'features', 'includedItems', 'updatedBy', 'updatedAt'
        ]);

      allow delete: if isOrderId(productId) && isAdmin();
    }

    // Staff Email Invitations (Root-admin issued; claimed atomically by verified invited email)
    match /adminInvites/{inviteId} {
      allow get: if isOrderId(inviteId) && (
        isBootstrappedAdmin()
        || (isSignedIn() && resource != null && existing().email == request.auth.token.email.lower())
      );

      allow list: if (isBootstrappedAdmin() && request.query.limit <= 200)
        || (isSignedIn() && resource.data.email == request.auth.token.email.lower() && request.query.limit <= 5);

      allow create: if isOrderId(inviteId)
        && isBootstrappedAdmin()
        && isValidAdminInvite(incoming(), inviteId)
        && incoming().status == 'pending'
        && incoming().invitedBy == request.auth.uid
        && !('claimedUid' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOrderId(inviteId)
        && isValidAdminInvite(incoming(), inviteId)
        && incoming().inviteId == existing().inviteId
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            isBootstrappedAdmin()
            && incoming().invitedBy == request.auth.uid
            && incoming().status in ['pending', 'revoked']
          )
          || (
            isSignedIn()
            && existing().status == 'pending'
            && existing().email == request.auth.token.email.lower()
            && incoming().status == 'claimed'
            && incoming().invitedBy == existing().invitedBy
            && 'claimedUid' in incoming()
            && incoming().claimedUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedUid', 'updatedAt'])
            && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid))
          )
        );

      allow delete: if isOrderId(inviteId) && isBootstrappedAdmin();
    }

    // Admin Authorization Registry (root-managed OR atomic email-invite claim by verified owner)
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isAdmin());
      allow list: if isBootstrappedAdmin() && request.query.limit <= 200;

      allow create: if isValidId(adminId)
        && isValidAdminAccount(incoming(), adminId)
        && incoming().createdAt == request.time
        && (
          (
            isBootstrappedAdmin()
            && incoming().grantedBy == request.auth.uid
          )
          || (
            isOwner(adminId)
            && 'inviteId' in incoming()
            && isOrderId(incoming().inviteId)
            && exists(/databases/$(database)/documents/adminInvites/$(incoming().inviteId))
            && get(/databases/$(database)/documents/adminInvites/$(incoming().inviteId)).data.status == 'pending'
            && get(/databases/$(database)/documents/adminInvites/$(incoming().inviteId)).data.email == request.auth.token.email.lower()
            && incoming().email == request.auth.token.email.lower()
            && incoming().grantedBy == get(/databases/$(database)/documents/adminInvites/$(incoming().inviteId)).data.invitedBy
            && getAfter(/databases/$(database)/documents/adminInvites/$(incoming().inviteId)).data.status == 'claimed'
            && getAfter(/databases/$(database)/documents/adminInvites/$(incoming().inviteId)).data.claimedUid == request.auth.uid
          )
        );

      allow update: if false;
      allow delete: if isValidId(adminId) && isBootstrappedAdmin();
    }

    // CollectionGroup rule for Admin order dispatch board (no per-doc resource reads)
    match /{path=**}/orders/{orderId} {
      allow list: if isAdmin() && request.query.limit <= 500;
    }

    // Account root document (owner read/write, admin read)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserAccount(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'workshopName', 'updatedAt']);

      allow delete: if false;

      // Private PII subcollection (owner read/write; admin single-doc read for verified order dispatch)
      match /private/{docId} {
        allow get: if isValidId(userId)
          && docId == 'info'
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId));

        allow create: if isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isValidId(userId)
          && docId == 'info'
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'kraPin', 'address', 'preferredCountyId', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if false;
      }

      // User Procurement Orders subcollection
      match /orders/{orderId} {
        allow get: if isValidId(userId)
          && isOrderId(orderId)
          && (
            (isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId)))
            || isAdmin()
          );

        allow list: if (isSignedIn() && request.auth.uid == userId && resource.data.userId == request.auth.uid)
          || (isAdmin() && request.query.limit <= 500);

        allow create: if isValidId(userId)
          && isOrderId(orderId)
          && isOwner(userId)
          && isValidUserOrder(incoming(), userId, orderId)
          && incoming().userId == request.auth.uid
          && incoming().status == 'confirmed'
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        // Only Admins may advance or override order fulfillment status
        allow update: if isValidId(userId)
          && isOrderId(orderId)
          && isAdmin()
          && isValidUserOrder(incoming(), userId, orderId)
          && (
            isAdmin() || (
              existing().status != 'completed'
              && isValidOrderTransition(existing().status, incoming().status)
            )
          )
          && incoming().orderId == existing().orderId
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if false;
      }
    }
  }
}
