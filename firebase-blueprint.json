{
  "entities": {
    "UserAccount": {
      "title": "User Account",
      "description": "Primary workshop account profile linked to authenticated Firebase user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 500
        },
        "workshopName": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "User Private Contact & Tax Profile",
      "description": "Isolated PII document storing contact phone, KRA PIN, email, and delivery address.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "kraPin": {
          "type": "string",
          "maxLength": 20
        },
        "address": {
          "type": "string",
          "maxLength": 200
        },
        "preferredCountyId": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "UserOrder": {
      "title": "Procurement Order Record",
      "description": "Authenticated buyer machinery procurement order summary saved under the user account.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "companyName": {
          "type": "string",
          "maxLength": 120
        },
        "countyId": {
          "type": "string",
          "maxLength": 40,
          "pattern": "^[a-z0-9\\-]+$"
        },
        "deliveryMode": {
          "type": "string",
          "enum": ["direct-site", "depot-pickup"]
        },
        "settlementMode": {
          "type": "string",
          "enum": ["full", "lipa-pole-pole"]
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["mpesa", "bank-wire", "lpo-credit", "depot-pay"]
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "dispatched", "completed"]
        },
        "totalAmountKes": {
          "type": "number"
        },
        "itemCount": {
          "type": "integer"
        },
        "itemsSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "voucherCode": {
          "type": "string",
          "maxLength": 30
        },
        "etimsControlNumber": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderId",
        "userId",
        "countyId",
        "deliveryMode",
        "settlementMode",
        "status",
        "totalAmountKes",
        "itemCount",
        "itemsSummary",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminAccount": {
      "title": "Administrator Authorization Record",
      "description": "Server-validated admin grant record indexed by verified Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120
        },
        "staffName": {
          "type": "string",
          "maxLength": 100
        },
        "roleLabel": {
          "type": "string",
          "maxLength": 80
        },
        "inviteId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "AdminInvite": {
      "title": "Staff Administrator Email Invitation",
      "description": "Email-based staff invitation issued by the root administrator and atomically claimed on verified sign-in.",
      "type": "object",
      "properties": {
        "inviteId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 120
        },
        "staffName": {
          "type": "string",
          "maxLength": 100
        },
        "roleLabel": {
          "type": "string",
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": ["pending", "claimed", "revoked"]
        },
        "invitedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "claimedUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["inviteId", "email", "status", "invitedBy", "createdAt", "updatedAt"]
    },
    "CatalogOverride": {
      "title": "Live Catalog Price, Inventory & Archive Override",
      "description": "Admin-managed live price, stock count, and archive visibility override for factory catalog machinery.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "priceKes": {
          "type": "number"
        },
        "inStock": {
          "type": "boolean"
        },
        "stockCount": {
          "type": "integer"
        },
        "archived": {
          "type": "boolean"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["productId", "priceKes", "inStock", "stockCount", "updatedBy", "updatedAt"]
    },
    "CatalogProduct": {
      "title": "Admin-Added Catalog Machine",
      "description": "Admin-created machinery equipment added dynamically to the live HaoSail storefront catalog.",
      "type": "object",
      "properties": {
        "productId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sku": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "enum": [
            "woodworking",
            "auto-maintenance",
            "welding-metalworking",
            "construction-concrete",
            "workshop-tools"
          ]
        },
        "categoryLabel": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "subCategory": {
          "type": "string",
          "maxLength": 60
        },
        "subCategoryLabel": {
          "type": "string",
          "maxLength": 80
        },
        "priceKes": {
          "type": "number"
        },
        "originalPriceKes": {
          "type": "number"
        },
        "stockCount": {
          "type": "integer"
        },
        "inStock": {
          "type": "boolean"
        },
        "freightTier": {
          "type": "string",
          "enum": ["standard-ground", "freight-ltl", "heavy-freight"]
        },
        "isFreeFreight": {
          "type": "boolean"
        },
        "isPopular": {
          "type": "boolean"
        },
        "isNewArrival": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "powerSource": {
          "type": "string",
          "enum": [
            "all",
            "corded-230v",
            "corded-115v",
            "cordless-18v",
            "3-phase-400v",
            "engine-manual"
          ]
        },
        "motor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "voltage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "amperage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "capacity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "footprint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "weightLbs": {
          "type": "number"
        },
        "warrantyYears": {
          "type": "integer"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "features": {
          "type": "array"
        },
        "includedItems": {
          "type": "array"
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "productId",
        "sku",
        "name",
        "subtitle",
        "category",
        "categoryLabel",
        "priceKes",
        "stockCount",
        "inStock",
        "freightTier",
        "isFreeFreight",
        "image",
        "powerSource",
        "motor",
        "voltage",
        "amperage",
        "capacity",
        "footprint",
        "weightLbs",
        "warrantyYears",
        "description",
        "features",
        "includedItems",
        "createdBy",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Top-level account record owned strictly by the matching Firebase Auth UID."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated private PII subcollection (`info` document) readable and writable only by owner and admins."
    },
    "/users/{userId}/orders/{orderId}": {
      "schema": { "$ref": "#/entities/UserOrder" },
      "description": "Procurement order history scoped strictly under the authenticated user's account."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminAccount" },
      "description": "Admin authorization registry; users cannot self-assign admin status without an atomic verified staff invite."
    },
    "/adminInvites/{inviteId}": {
      "schema": { "$ref": "#/entities/AdminInvite" },
      "description": "Root-admin issued email invitations that allow verified staff members to atomically activate their admin record upon sign-in."
    },
    "/catalogOverrides/{productId}": {
      "schema": { "$ref": "#/entities/CatalogOverride" },
      "description": "Publicly readable live inventory, price, and archive overrides writable only by verified admins."
    },
    "/catalogProducts/{productId}": {
      "schema": { "$ref": "#/entities/CatalogProduct" },
      "description": "Publicly readable custom machinery items created, updated, and deleted exclusively by verified admins."
    }
  }
}
